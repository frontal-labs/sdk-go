package main

import (
	"context"
	"encoding/json"
	"log"
	"os"
	"os/signal"
	"syscall"

	frontal "github.com/frontal-labs/sdk-go"
	"github.com/frontal-labs/sdk-go/pkg/resources"
)

func main() {
	if len(os.Args) != 2 {
		log.Fatal("usage: stream-consumer RUN_ID")
	}
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	client, err := frontal.New()
	if err != nil {
		log.Fatal(err)
	}
	endpoint, ok := client.Agents.Endpoint("STREAM", "/agents/runs/{param}/stream")
	if !ok {
		log.Fatal("agent run stream endpoint is missing from the SDK catalog")
	}
	request := resources.Request{Endpoint: endpoint, PathParams: []string{os.Args[1]}}
	events, err := frontal.Watch[map[string]any](ctx, client.Agents, request)
	if err != nil {
		log.Fatal(err)
	}
	encoder := json.NewEncoder(os.Stdout)
	for {
		select {
		case <-ctx.Done():
			return
		case item, ok := <-events:
			if !ok {
				return
			}
			if item.Err != nil {
				log.Fatal(item.Err)
			}
			if item.Event != nil {
				if err := encoder.Encode(item.Event); err != nil {
					log.Fatal(err)
				}
			}
		}
	}
}
