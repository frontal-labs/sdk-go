package main

import (
	"context"
	"encoding/json"
	"log"
	"os"
	"os/signal"
	"syscall"

	"github.com/frontal-labs/sdk-go/pkg/resources"
	"github.com/frontal-labs/sdk-go/pkg/handlers"
)

func main() {
	if len(os.Args) != 2 {
		log.Fatal("usage: stream-consumer RUN_ID")
	}
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	client, err := resources.NewClientFromEnv()
	if err != nil {
		log.Fatal(err)
	}
	endpoint, ok := resources.FindEndpoint("agents", "STREAM", "/agents/runs/{param}/stream")
	if !ok {
		log.Fatal("agent run stream endpoint is missing from the SDK catalog")
	}
	request := resources.Request{Endpoint: endpoint, PathParams: []string{os.Args[1]}}
	err = resources.StreamEvents[map[string]any](ctx, client, request, func(event handlers.Event[map[string]any]) error {
		return json.NewEncoder(os.Stdout).Encode(event)
	})
	if err != nil && ctx.Err() == nil {
		log.Fatal(err)
	}
}
