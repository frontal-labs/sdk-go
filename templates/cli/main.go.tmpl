package main

import (
	"context"
	"encoding/json"
	"fmt"
	"log"
	"os"
	"os/signal"
	"syscall"

	frontal "github.com/frontal-labs/sdk-go/v2"
	"github.com/frontal-labs/sdk-go/v2/agents"
)

func main() {
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	client, err := frontal.New()
	if err != nil {
		log.Fatal(err)
	}
	endpoint, ok := client.Agents.Endpoint("GET", "/agents/health")
	if !ok {
		log.Fatal("agents health endpoint is missing from the SDK catalog")
	}
	var health map[string]any
	if err := client.Agents.Call(ctx, agents.Request{Endpoint: endpoint}, &health); err != nil {
		log.Fatal(err)
	}
	if err := json.NewEncoder(os.Stdout).Encode(health); err != nil {
		fmt.Fprintln(os.Stderr, err)
		os.Exit(1)
	}
}
