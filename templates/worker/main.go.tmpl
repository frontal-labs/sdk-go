package main

import (
	"context"
	"log"
	"os"
	"os/signal"
	"syscall"
	"time"

	frontal "github.com/frontal-labs/sdk-go"
	"github.com/frontal-labs/sdk-go/pkg/resources"
)

func main() {
	ctx, stop := signal.NotifyContext(context.Background(), os.Interrupt, syscall.SIGTERM)
	defer stop()

	client, err := frontal.New()
	if err != nil {
		log.Fatal(err)
	}
	endpoint, ok := client.Agents.Endpoint("GET", "/agents/health")
	if !ok {
		log.Fatal("agents health endpoint is missing from the SDK catalog")
	}
	ticker := time.NewTicker(30 * time.Second)
	defer ticker.Stop()

	if err := refresh(ctx, client, endpoint); err != nil {
		log.Printf("initial refresh failed: %v", err)
	}
	for {
		select {
		case <-ctx.Done():
			return
		case <-ticker.C:
			if err := refresh(ctx, client, endpoint); err != nil {
				log.Printf("refresh failed: %v", err)
			}
		}
	}
}

func refresh(ctx context.Context, client *frontal.Client, endpoint resources.Endpoint) error {
	var health map[string]any
	return client.Agents.Call(ctx, resources.Request{Endpoint: endpoint}, &health)
}
